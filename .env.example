# Copy to .env.local for local dev. Never commit real values.

# --- Database (required in production) ---
# Supabase Postgres. On Vercel these come from the Supabase marketplace integration
# (`vercel env pull .env.local`). SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Pooled (transaction pooler) URL used by the app:
POSTGRES_URL=
# Session/direct URL used by `npm run db:migrate`:
POSTGRES_URL_NON_POOLING=

# --- Anti-abuse (required in production) ---
# Long random string used to HMAC network addresses. Generate: openssl rand -hex 32
REPORTER_HASH_SECRET=

# --- Scheduled refresh (required in production) ---
# Shared secret for /api/cron/refresh. Also set as GitHub repo secret CRON_SECRET (with LIGHTDEY_URL).
CRON_SECRET=

# --- Data sources (see SOURCES.md) ---
# Live, no credentials needed. Set to 0 to switch a source off immediately.
SOURCE_NISO_ENABLED=1
SOURCE_IKEJA_NOTICES_ENABLED=1
# Opportunistic refresh after /api/status responses (leases keep it rate-limited). 0 disables.
LIGHTDEY_ONDEMAND_REFRESH=1
# Not implemented — only needed if X (Twitter) DisCo posts are added later (paid X API).
# X_BEARER_TOKEN=
# Partners / verified reporters do NOT use env vars: issue per-partner keys with `npm run partner:key`.

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Dev escape hatch: run a production build without Supabase (data resets on restart).
# LIGHTDEY_ALLOW_MEMORY_STORE=1
# Force the in-memory store locally even when POSTGRES_URL is set:
# LIGHTDEY_FORCE_MEMORY_STORE=1
