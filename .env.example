# Copy to .env.local for local dev. Never commit real values.

# --- Supabase (required in production) ---
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Anti-abuse (required in production) ---
# Long random string used to HMAC network addresses. Generate: openssl rand -hex 32
REPORTER_HASH_SECRET=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Dev escape hatch: run a production build without Supabase (data resets on restart).
# LIGHTDEY_ALLOW_MEMORY_STORE=1
